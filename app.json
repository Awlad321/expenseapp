{
  "expo": {
    "name": "ExpensApp",
    "slug": "expensapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/expnesapp_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/expnesapp_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#061314"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.example.expensapp",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/expnesapp_logo.png",
        "backgroundColor": "#061314"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "f8b1ef75-be7b-4a9b-8d11-980489f80b0a"
      }
    }
  }
}
